editor:
  version:
    created: v1.58.0
entry: start
type: generic
nodes:
  - id: start
    type: core/start@v1
    position:
      x: -400
      y: 400
  - id: filepath-location
    type: core/filepath-location@v1
    position:
      x: -400
      y: 200
    inputs:
      location: current_graph
  - id: filepath-dir
    type: core/filepath-op@v1
    position:
      x: -100
      y: 200
    inputs:
      op: dir
  - id: compress-dir-path
    type: core/filepath-join@v1
    position:
      x: 200
      y: 200
    inputs:
      segments[0]: null
      segments[1]: compress_me
  - id: compress
    type: core/file-compress@v1
    position:
      x: 500
      y: 400
    inputs:
      format: zip
  - id: dir-walk
    type: core/dir-walk@v1
    position:
      x: 200
      y: 400
    inputs:
      recursive: true
      dirs: false
      files: true
      path: null
  - id: decompress-dest-path
    type: core/filepath-join@v1
    position:
      x: 500
      y: 200
    inputs:
      segments[0]: null
      segments[1]: decompressed_output
  - id: decompress
    type: core/file-decompress@v1
    position:
      x: 800
      y: 400
    inputs:
      format: zip
  - id: print-files
    type: core/print@v1
    position:
      x: 1100
      y: 400
    inputs:
      values[0]: null
      color: fg_green
  - id: print-done
    type: core/print@v1
    position:
      x: 1400
      y: 400
    inputs:
      values[0]: decompression test passed
      color: fg_green
connections:
  - src:
      node: filepath-location
      port: result
    dst:
      node: filepath-dir
      port: path
  - src:
      node: filepath-dir
      port: result
    dst:
      node: compress-dir-path
      port: segments[0]
  - src:
      node: filepath-dir
      port: result
    dst:
      node: decompress-dest-path
      port: segments[0]
  - src:
      node: compress-dir-path
      port: result
    dst:
      node: dir-walk
      port: path
  - src:
      node: dir-walk
      port: items_abs
    dst:
      node: compress
      port: paths
  - src:
      node: filepath-dir
      port: result
    dst:
      node: compress
      port: base_path
  - src:
      node: compress
      port: data
    dst:
      node: decompress
      port: data
  - src:
      node: decompress-dest-path
      port: result
    dst:
      node: decompress
      port: dest_path
  - src:
      node: decompress
      port: files
    dst:
      node: print-files
      port: values[0]
executions:
  - src:
      node: start
      port: exec
    dst:
      node: dir-walk
      port: exec
  - src:
      node: dir-walk
      port: exec-success
    dst:
      node: compress
      port: exec
  - src:
      node: compress
      port: exec-success
    dst:
      node: decompress
      port: exec
  - src:
      node: decompress
      port: exec-success
    dst:
      node: print-files
      port: exec
  - src:
      node: print-files
      port: exec
    dst:
      node: print-done
      port: exec
